---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { href } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  /** 全幅：放弃 44rem 容器与内边距，让内容（如星图）铺满视口宽度 */
  bleed?: boolean;
  /** OG 图 slug（/og/<ogSlug>.png）；缺省用站点卡片 _site */
  ogSlug?: string;
}

const { title, description, bleed = false, ogSlug = "_site" } = Astro.props;
const siteName = "What I've Learned";
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const mainClass = bleed
  ? "flex-1 w-full"
  : "flex-1 w-full max-w-[44rem] mx-auto px-6 md:px-8";
const ogImage = href(`/og/${ogSlug}.png`);
const ogDescription =
  description ?? "读过的、看完的、动手写下来的——两个 markdown 目录里的人生。";
---

<!doctype html>
<html lang="zh-CN" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink-3">
    <SiteHeader />
    <main class={mainClass}>
      <slot />
    </main>
    <SiteFooter />
    <script>
      // ⌘K / Ctrl+K：首次按键才加载面板 + minisearch + 索引（首屏零成本）
      let palette: typeof import("../scripts/command-palette") | null = null;
      let loading = false;
      document.addEventListener("keydown", (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
          e.preventDefault();
          if (!palette && !loading) {
            loading = true;
            import("../scripts/command-palette")
              .then(async (mod) => {
                palette = mod;
                await mod.ensurePalette();
                mod.openPalette();
              })
              .catch((err) => {
                // 加载失败允许下次重试（loading 复位）
                loading = false;
                console.error("[palette]", err);
              });
          } else if (palette) {
            palette.openPalette();
          }
        } else if (e.key === "Escape" && palette) {
          palette.closePalette();
        }
      });
    </script>
  </body>
</html>
