---
import type { LearnedMaterial } from "../lib/content";
import {
  formatDay,
  formatMinutes,
  formatPages,
  TYPE_PLURAL,
} from "../lib/materials";
/**
 * 时间线条目行（计划 §3.1，260909 修订）：
 * 日期(mono) · 标题(衬线，链接到原材料) · 类型 · 用时/页数 · 标签 · 示例角标
 * comment = 个人短评（随行；有正文时两行截断 + note → 进详情页）。
 */
import { href, slugify } from "../lib/url";

interface Props {
  item: LearnedMaterial;
}

const { item } = Astro.props;
// meta 首位是分类（媒体类型右侧已有）；无分类条目直接从用时开始
const meta: string[] = [];
if (item.duration) meta.push(formatMinutes(item.duration));
if (item.pages) meta.push(formatPages(item.pages));
const hasCat = Boolean(item.category && item.category.length > 0);
const catHref = hasCat
  ? href(`/category/${item.category?.map(slugify).join("/")}/`)
  : null;
// 标题永远指向原材料本身；没有原文的落回本站详情页
const titleHref = item.url ?? href(`/m/${item.slug}/`);
const isExternal = Boolean(item.url);
---

<article
  class="entry"
  data-type={item.type}
  data-cat={item.category?.[0] ?? 'none'}
>
  <span class="when text-meta" aria-hidden="true">{formatDay(item.date)}</span>
  <div class="body">
    <h3 class="m-0 text-[1.0625rem] leading-snug">
      <a
        class="font-serif text-ink font-medium no-underline hover:text-accent transition-colors"
        href={titleHref}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener noreferrer' : undefined}
      >{item.title}</a>
      {item.demo && <span class="badge text-meta" title="演示条目，交付前替换为真实记录">示例</span>}
      {item.revisit && <span class="badge text-meta" title="值得重读">revisit</span>}
    </h3>
    {item.comment && (
      <p class={`comment font-serif italic text-ink-4 text-[0.9375rem] mt-1 mb-0${item.hasBody ? ' clamp' : ''}`}>
        {item.comment}
      </p>
    )}
    <p class="meta text-meta m-0 mt-1">
      {hasCat && catHref && (
        <a class="cat" href={catHref}>{item.category?.join(' / ')}</a>
      )}
      {hasCat && (meta.length > 0 || item.tags.length > 0 || item.hasBody) && ' · '}
      {meta.length > 0 && meta.join(' · ')}
      {meta.length > 0 && (item.tags.length > 0 || item.hasBody) && ' · '}
      {item.tags.length > 0 && (
        <span class="tags">
          {item.tags.map((tag) => (
            <a class="tag" href={href(`/tags/${tag}/`)}>{tag}</a>
          ))}
        </span>
      )}
      {item.hasBody && (
        <>
          {item.tags.length > 0 && ' · '}
          <a class="note-link" href={href(`/m/${item.slug}/`)}>note →</a>
        </>
      )}
    </p>
  </div>
  <span class="type text-meta" aria-hidden="true">{TYPE_PLURAL[item.type]}</span>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: 3.25rem 1fr auto;
    align-items: baseline;
    column-gap: 1rem;
    padding: 0.65rem 0;
  }
  /* 月度叙事流的呼吸：条目之间用发丝线而非间距堆叠 */
  .entry + .entry {
    border-top: 1px solid var(--color-line);
  }

  .when {
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-4);
  }

  .body { min-width: 0; }

  .badge {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0 0.375rem;
    border: 1px solid var(--color-line-2);
    border-radius: var(--radius-sm);
    color: var(--color-ink-4);
    font-size: 0.625rem;
    line-height: 1.5;
    vertical-align: 2px;
  }

  .comment { max-width: 38rem; }
  /* 有详情页可看全文时才截断（note → 即 view more） */
  .clamp {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .meta .cat {
    color: var(--color-ink-4);
    text-decoration: none;
    border-bottom: 1px dotted var(--color-line-2);
  }
  .meta .cat:hover { color: var(--color-accent); border-color: currentColor; }
  .meta .tags { color: var(--color-ink-4); }
  .meta .tag {
    color: var(--color-ink-4);
    text-decoration: none;
  }
  .meta .tag:hover { color: var(--color-accent); }
  .meta .tag + .tag { margin-left: 0.55em; }
  .meta .note-link {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
  }
  .meta .note-link:hover { color: var(--color-accent-deep); }

  .type {
    color: var(--color-ink-4);
    font-size: 0.6875rem;
    display: none;
  }
  @media (min-width: 640px) {
    .type { display: inline; }
  }
</style>
