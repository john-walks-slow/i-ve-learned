---
import { href } from "../lib/url";

const path = Astro.url.pathname.replace(/\/+$/, "");
const isActive = (target: string) => {
  const t = href(target);
  return path === t || (target === "/" && path === href("/"));
};

const links = [
  { href: "/", label: "Timeline" },
  { href: "/atlas/", label: "Atlas" },
  { href: "/backlog/", label: "Backlog" },
];
---

<header class="sticky top-0 z-40 bg-paper border-b border-line">
  <nav
    class="max-w-[44rem] mx-auto px-6 md:px-8 h-14 flex items-center justify-between"
    aria-label="Main"
  >
    <a
      href={href('/')}
      class="font-serif font-semibold text-ink text-[1.05rem] tracking-tight no-underline hover:text-accent transition-colors duration-150 ease-snap active:text-accent-deep"
    >
      What I’ve Learned
    </a>
    <ul class="flex items-center gap-1 list-none m-0 p-0">
      {
        links.map((link) => (
          <li>
            <a
              href={href(link.href)}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'text-ui px-2.5 py-1.5 rounded-sm no-underline transition-colors duration-150 ease-snap',
                'hover:bg-paper-2 hover:text-ink active:bg-accent-wash',
                isActive(link.href)
                  ? 'text-ink font-medium'
                  : 'text-ink-4',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="hidden sm:block ml-2">
        <button id="ck-trigger" class="ck-hint-key" type="button"
                aria-label="open command palette" title="搜索（Ctrl+K）">⌘K</button>
      </li>
    </ul>
  </nav>
</header>

<style>
  .ck-hint-key {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-ink-4);
    border: 1px solid var(--color-line-2);
    border-radius: var(--radius-sm);
    padding: 0.125rem 0.375rem;
    user-select: none;
    background: transparent;
    cursor: pointer;
    transition: color 0.15s var(--ease-snap), border-color 0.15s var(--ease-snap);
  }
  .ck-hint-key:hover { color: var(--color-ink-2); border-color: var(--color-ink-5); }
  .ck-hint-key:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
</style>
