---
import { href } from "../lib/url";

const path = Astro.url.pathname.replace(/\/+$/, "");
const isActive = (target: string) => {
  const t = href(target);
  return path === t || (target === "/" && path === href("/"));
};

const links = [
  { href: "/", label: "Timeline" },
  { href: "/atlas/", label: "Atlas" },
  { href: "/backlog/", label: "Backlog" },
];
---

<header class="sticky top-0 z-40 bg-paper border-b border-line">
  <nav
    class="max-w-[44rem] mx-auto px-6 md:px-8 h-14 flex items-center justify-between"
    aria-label="Main"
  >
    <a
      href={href('/')}
      class="font-serif font-semibold text-ink text-[1.05rem] tracking-tight no-underline hover:text-accent transition-colors duration-150 ease-snap active:text-accent-deep"
    >
      What I’ve Learned
    </a>
    <ul class="flex items-center gap-1 list-none m-0 p-0">
      {
        links.map((link) => (
          <li>
            <a
              href={href(link.href)}
              aria-current={isActive(link.href) ? 'page' : undefined}
              class:list={[
                'text-ui px-2.5 py-1.5 rounded-sm no-underline transition-colors duration-150 ease-snap',
                'hover:bg-paper-2 hover:text-ink active:bg-accent-wash',
                isActive(link.href)
                  ? 'text-ink font-medium'
                  : 'text-ink-4',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
